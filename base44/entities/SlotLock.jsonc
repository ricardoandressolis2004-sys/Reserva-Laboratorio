{
  "name": "SlotLock",
  "type": "object",
  "properties": {
    "slot_key": {
      "type": "string"
    },
    "holder_token": {
      "type": "string"
    },
    "holder_name": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "slot_key",
    "holder_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}