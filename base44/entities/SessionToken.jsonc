{
  "name": "SessionToken",
  "type": "object",
  "properties": {
    "token_hash": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "session",
        "reset"
      ],
      "default": "session"
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "admin"
      ],
      "default": "student"
    },
    "user_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "token_hash",
    "user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}